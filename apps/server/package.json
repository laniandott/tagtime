{
  "name": "@tagtime/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test test/helpers.test.ts test/links.test.ts test/server.test.ts test/http.test.ts test/watcher.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "recovery:drill": "node scripts/recovery-drill.mjs",
    "backup:drill": "node scripts/backup-restore-drill.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^6.1.0",
    "chokidar": "^5.0.0",
    "fastify": "^5.2.0",
    "node-ical": "^0.27.1",
    "prisma": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "schema": "src/schema.prisma"
  }
