// TagTime - Tag-based time tracker
// 数据模型：Category(分类) -> Tag(标签) -> TimeEntry(时间记录)
//          Todo(待办) 可选关联 Category 和 TimeEntry
//          Goal(目标) 关联 Tag，支持时长型/次数型习惯追踪

generator client {
  provider   = "prisma-client-js"
  engineType = "wasm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 标签分类：用户自定义的大类，如 日常/工作/宝宝
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6d5efc")
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags  Tag[]
  todos Todo[]
}

/// 标签：归属某个分类，如 日常/吃饭、工作/编码
/// trackType: "time"=时长计时（默认），"count"=次数打卡
model Tag {
  id         String   @id @default(cuid())
  name       String
  color      String   @default("#6d5efc")
  icon       String?
  categoryId String?
  trackType  String   @default("time") // time | count
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  goals      Goal[]
  memos      Memo[]

  @@unique([name, categoryId])
}

/// 时间记录：一次计时的开始与结束。endTime 为 null 表示进行中
model TimeEntry {
  id        String    @id @default(cuid())
  startTime DateTime  @default(now())
  endTime   DateTime?
  note      String?
  tagId     String
  todoId    String?

  tag       Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)
  todo      Todo?  @relation(fields: [todoId], references: [id], onDelete: SetNull)
  memos     Memo[]

  createdAt DateTime @default(now())

  @@index([tagId])
  @@index([startTime])
  @@index([todoId])
}

/// 待办事项：可关联分类，可关联时间记录
model Todo {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending") // pending | done
  priority    Int      @default(0)          // 0=普通 1=重要 2=紧急
  dueDate     DateTime?
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([status])
  @@index([categoryId])
}

/// 目标（习惯养成）：关联标签，支持时长型或次数型
/// type: "time"=时长目标(分钟)，"count"=次数目标
/// period: "daily"=每日，"weekly"=每周，"monthly"=每月
/// periodDays: 自定义周期天数（当 period="custom" 时使用）
model Goal {
  id          String   @id @default(cuid())
  tagId       String
  title       String
  type        String   @default("count") // time | count
  target      Int      @default(1)        // 目标值（次数 或 分钟数）
  period      String   @default("daily")  // daily | weekly | monthly | custom
  periodDays  Int?                         // 自定义周期天数
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tag         Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
  @@index([active])
}

/// 记事/日记：与 TimeEntry 建立勾稽关联，支持富文本与多媒体附件
model Memo {
  id          String   @id @default(cuid())
  content     String   // 记事/日记内容
  timeEntryId String?  // 关联的具体计时记录
  tagId       String?  // 可选关联标签
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timeEntry   TimeEntry?   @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  tag         Tag?         @relation(fields: [tagId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([timeEntryId])
  @@index([createdAt])
  @@index([tagId])
}

/// 附件：图片或视频文件
model Attachment {
  id        String   @id @default(cuid())
  memoId    String
  filename  String   // 原始文件名
  path      String   // 相对访问路径 /uploads/xxx.jpg
  mimeType  String   // image/png, video/mp4 等
  size      Int      // 文件大小(bytes)
  createdAt DateTime @default(now())

  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
}

